[Unit]
Description=Check for and install gitops-agent updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root (no User=): the update subcommand installs into
# /usr/local/bin and restarts gitops-agent.service, both of which need
# privileges the unprivileged service user doesn't have.
#
# ExecStart points at the same binary gitops-agent.service runs, unlike
# the old update.bash-based unit this replaces: that one had to point at a
# root-owned copy outside the checkout, since running root-owned bash
# straight out of a user-writable checkout would let anyone who can write
# there get root the next time this timer fires. That risk doesn't apply
# here -- there's no bash to source, and the binary itself is root-owned
# (installed by `gitops-agent update` or scripts/install.sh with mode
# 0755, owner root), so the unprivileged service user can run it but never
# modify it. See internal/selfupdate.
ExecStart=/usr/local/bin/gitops-agent update
