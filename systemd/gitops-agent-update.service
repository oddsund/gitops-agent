[Unit]
Description=Check for and install gitops-agent updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root (no User=): the update subcommand replaces the binary in
# /usr/local/bin and restarts gitops-agent.service, which the unprivileged
# service user cannot do.
#
# gh has no login as root; with gh installed, /etc/gitops-agent/github-token
# (root, 0600) must exist or verification fails closed.
#
# ExecStart runs the same binary gitops-agent.service runs. `gitops-agent
# install` refuses to proceed unless that binary is owned by root and not
# group- or world-writable, so the service user can execute it but not
# modify it. Nothing here executes code out of a user-writable checkout.
# The check runs at install time only; replacing the binary afterwards is
# the update subcommand's job.
ExecStart=/usr/local/bin/gitops-agent update
