# Example config.toml for gitops-agent.
#
# This is the host-local bootstrap config: where the repo lives and how to
# reach it. By default it's read from /etc/gitops-agent/config.toml
# (override with -config). It's meant to be written once by whatever
# provisions the host, and rarely touched afterwards -- which services
# actually get deployed is tracked in the repo itself, at services.toml,
# not here. See docs/configuration.md for the full reference.

[git]
# Any URL go-git can clone. SSH is the common choice so the same key can
# also serve as the sops decryption identity below.
repo_url = "git@github.com:example/services.git"
branch = "main"

# Where the repo gets cloned to on this host. Separate from wherever this
# config file itself lives.
clone_path = "/opt/gitops-agent/repo"

# Idle cadence: how often to poll when nothing has changed for a while.
pull_interval_seconds = 300

# Commits tend to arrive in bursts -- you push a change, spot something
# wrong, push a fix. So after a poll that finds new commits, drop to
# active_interval_seconds and stay there until active_window_seconds have
# passed with nothing new. Then decay back to pull_interval_seconds.
#
# Both are optional; omitting them gives the defaults below, so a minimal
# config.toml with just repo_url/branch/clone_path/pull_interval_seconds
# and [sops].ssh_key_path is valid on its own.
active_interval_seconds = 15
active_window_seconds = 900

# Deploys are normally skipped for services whose files didn't change,
# which means drift invisible to git (a container stopped by hand, one
# that died for good) would never get corrected. This bounds how long
# that can last: every this often, every enabled service is deployed
# regardless.
full_reconcile_interval_seconds = 3600

[sops]
# Used two ways: as the SSH key for git authentication above, and as-is
# (no conversion needed on recent sops/age versions) as the sops age
# decryption identity for each service's secrets.enc.env. See
# docs/secrets.md.
ssh_key_path = "/home/pi/.ssh/id_ed25519"

# Where gitops-agent records which services it last deployed and from
# where, so a service can be torn down (docker compose down) once it's
# disabled or its [[services]] block is deleted from services.toml.
# Optional -- defaults to /var/lib/gitops-agent/deployed.json, which
# matches the StateDirectory= the systemd unit creates. Override mainly
# for local runs outside systemd.
# [state]
# path = "/var/lib/gitops-agent/deployed.json"

# The status page (internal/statusserver): /healthz, / and /status.json.
# Optional -- omitting [status] entirely defaults to 127.0.0.1:9090,
# which is the right default for a bare `go run` or a local test, but
# isn't reachable from anywhere else. Uncomment and change listen_addr if
# you're putting a reverse proxy in front of the status page, especially
# one that runs in a container and can't reach the host's loopback
# interface -- see docs/status-page.md.
# [status]
# listen_addr = "0.0.0.0:9090"

# Email when a service starts failing or recovers (internal/notify).
# Optional -- leaving [notify] out, or smtp_host empty, turns it off and
# the agent says nothing about it. See docs/configuration.md.
#
# The password does NOT go in this file (it is world-readable). Put it in
# password_file: a regular file owned by the user the agent runs as, mode
# 0600. The agent refuses to use a file that group or others can read.
# [notify]
# smtp_host = "smtp.example.org"
# smtp_port = 587                # 465 for tls = "implicit"
# tls = "starttls"               # "starttls", "implicit", or "none" (loopback only)
# from = "gitops-agent@example.org"
# to = ["you@example.org"]
# username = "gitops-agent@example.org"
# password_file = "/etc/gitops-agent/smtp-password"
# min_interval_seconds = 3600
# include_error = false          # true adds the first line of the error text
# status_url = "https://status.example.org/"
